# Settings for compose.yaml (copy to .env).

# Physical USB port path of the Commander PRO (`commander-probe list` on the host).
COMCONTROL_USB_PATH=1-2.3
# Major number of hidraw devices:  grep hidraw /proc/devices
HIDRAW_MAJOR=242
# Group owning the controller's hidraw node (udev rule), e.g. `getent group plugdev`.
COMCONTROL_GID=46
# Listen address on the host (0.0.0.0 for LAN access) and port.
COMCONTROL_BIND=127.0.0.1
COMCONTROL_PORT=8080
# Recommended for LAN use: host names under which the UI is reached.
COMCONTROL_ALLOWED_HOSTS=
